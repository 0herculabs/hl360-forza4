@@ -0,0 +1,35 @@
+# Experimental conversion boundary. Vulkan remains the selectable macOS backend.
+if(NOT APPLE)
+    message(FATAL_ERROR "Native Metal shader tools require macOS")
+endif()
+set(REXGLUE_METAL_DEPS_ROOT "" CACHE PATH "Staged DXC and Metal Shader Converter headers/libraries")
+foreach(required dxc/include/DxbcConverter.h msc/include/metal_irconverter.h
+                 lib/libdxilconv.dylib lib/libLLVMDxcSupport.a lib/libmetalirconverter.dylib)
+    if(NOT EXISTS "${REXGLUE_METAL_DEPS_ROOT}/${required}")
+        message(FATAL_ERROR "Missing Metal dependency: ${REXGLUE_METAL_DEPS_ROOT}/${required}")
+    endif()
+endforeach()
+add_library(rexmetal-shader STATIC
+    dxbc_to_dxil_converter.cpp metal_shader_converter.cpp
+    ../flags.cpp ../registers.cpp ../util/draw.cpp ../pipeline/shader/shader.cpp ../format/ucode.cpp
+    ../pipeline/shader/translator.cpp ../pipeline/shader/translator_disasm.cpp)
+foreach(source IN LISTS REXGPU_XENOS_DXBC_SOURCES)
+    target_sources(rexmetal-shader PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/../${source}")
+endforeach()
+target_sources(rexmetal-shader PRIVATE ${REXGPU_XENOS_DXBC_THIRDPARTY_SOURCES})
+target_include_directories(rexmetal-shader PRIVATE
+    "${REXGLUE_ROOT}"
+    "${REXGLUE_METAL_DEPS_ROOT}/dxc/include"
+    "${REXGLUE_METAL_DEPS_ROOT}/msc/include")
+# DXC's COM declarations require Clang's Microsoft extensions, not Windows APIs.
+set_source_files_properties(dxbc_to_dxil_converter.cpp PROPERTIES
+    COMPILE_OPTIONS "-fms-extensions")
+target_link_libraries(rexmetal-shader PUBLIC rexruntime PRIVATE
+    xxHash::xxhash
+    "${REXGLUE_METAL_DEPS_ROOT}/lib/libdxilconv.dylib"
+    "${REXGLUE_METAL_DEPS_ROOT}/lib/libLLVMDxcSupport.a"
+    "${REXGLUE_METAL_DEPS_ROOT}/lib/libmetalirconverter.dylib")
+add_executable(rex-metal-shader-check shader_check.cpp library_check.mm)
+set_source_files_properties(library_check.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
+target_link_libraries(rex-metal-shader-check PRIVATE "-framework Metal" "-framework Foundation")
+target_link_libraries(rex-metal-shader-check PRIVATE rexmetal-shader xxHash::xxhash)
diff --git a/src/graphics/metal/dxbc_to_dxil_converter.cpp b/src/graphics/metal/dxbc_to_dxil_converter.cpp
new file mode 100644
index 0000000..18c6322
--- /dev/null
+++ b/src/graphics/metal/dxbc_to_dxil_converter.cpp
@@ -0,0 +1,229 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2025 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+/**
+ * DXBC to DXIL converter implementation
+ * Uses the in-process dxilconv library on macOS.
+ */
+
+#include <rex/graphics/metal/dxbc_to_dxil_converter.h>
+
+#include <unistd.h>
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <string>
+
+#include "DxbcConverter.h"
+#include <rex/logging.h>
+
+namespace rex::graphics::metal {
+
+namespace {
+constexpr wchar_t kDefaultExtraOptions[] = L"-skip-container-parts";
+
+const CLSID kClsidDxbcConverter = {
+    0x4900391e,
+    0xb752,
+    0x4edd,
+    {0xa8, 0x85, 0x6f, 0xb7, 0x6e, 0x25, 0xad, 0xdb}};
+std::wstring WidenAscii(const std::string& value) {
+  std::wstring out;
+  out.reserve(value.size());
+  for (char c : value) {
+    out.push_back(static_cast<wchar_t>(c));
+  }
+  return out;
+}
+
+std::string HResultHex(HRESULT hr) {
+  char buffer[11];
+  std::snprintf(buffer, sizeof(buffer), "%08X", static_cast<unsigned>(hr));
+  return std::string(buffer);
+}
+
+struct ThreadConverter {
+  IDxbcConverter* converter = nullptr;
+  ~ThreadConverter() {
+    if (converter) {
+      converter->Release();
+    }
+  }
+};
+}  // namespace
+
+DxbcToDxilConverter::DxbcToDxilConverter() = default;
+
+DxbcToDxilConverter::~DxbcToDxilConverter() = default;
+
+bool DxbcToDxilConverter::Initialize() {
+  const char* extra_options = std::getenv("REX_METAL_DXBC2DXIL_FLAGS");
+  if (extra_options) {
+    extra_options_ = WidenAscii(extra_options);
+  } else {
+    extra_options_ = kDefaultExtraOptions;
+  }
+
+  IDxbcConverter* test_converter = nullptr;
+  HRESULT hr = DxcCreateInstance(kClsidDxbcConverter, __uuidof(IDxbcConverter),
+                                 reinterpret_cast<void**>(&test_converter));
+  if (hr != S_OK || !test_converter) {
+    REXLOG_ERROR("DxbcToDxilConverter: Failed to create IDxbcConverter (hr=0x{:08X})",
+           static_cast<unsigned>(hr));
+    is_available_ = false;
+    return false;
+  }
+  test_converter->Release();
+
+  dxilconv_path_ = "linked";
+  is_available_ = true;
+  if (extra_options && *extra_options) {
+    REXLOG_INFO("DxbcToDxilConverter: Using extra options: {}", extra_options);
+  } else if (extra_options && !*extra_options) {
+    REXLOG_INFO("DxbcToDxilConverter: Extra options disabled via env");
+  } else {
+    REXLOG_INFO(
+        "DxbcToDxilConverter: Using default extra options: "
+        "-skip-container-parts");
+  }
+  return true;
+}
+
+bool DxbcToDxilConverter::Convert(const std::vector<uint8_t>& dxbc_data,
+                                  std::vector<uint8_t>& dxil_data_out,
+                                  std::string* error_message) {
+  if (!is_available_) {
+    if (error_message) {
+      *error_message =
+          "DxbcToDxilConverter not initialized or dxilconv unavailable";
+    }
+    return false;
+  }
+
+  // Validate DXBC header
+  if (dxbc_data.size() < 4 || dxbc_data[0] != 'D' || dxbc_data[1] != 'X' ||
+      dxbc_data[2] != 'B' || dxbc_data[3] != 'C') {
+    if (error_message) {
+      *error_message = "Invalid DXBC data - missing DXBC magic header";
+    }
+    return false;
+  }
+
+  // Check for debug output directories from environment
+  const char* dxbc_dir = std::getenv("REX_METAL_DXBC_OUTPUT_DIR");
+  const char* dxil_dir = std::getenv("REX_METAL_DXIL_OUTPUT_DIR");
+
+  // Generate unique shader ID based on data hash
+  uint64_t hash = 0;
+  const size_t hash_bytes = std::min(dxbc_data.size(), size_t(64));
+  for (size_t i = 0; i < hash_bytes; ++i) {
+    hash = hash * 31 + dxbc_data[i];
+  }
+  std::string shader_id = std::to_string(hash) + "_" + std::to_string(getpid());
+
+  // Save DXBC to debug directory if requested.
+  if (dxbc_dir) {
+    std::string debug_input =
+        std::string(dxbc_dir) + "/shader_" + shader_id + ".dxbc";
+    WriteFile(debug_input, dxbc_data);
+  }
+
+  IDxbcConverter* converter = GetThreadConverter(error_message);
+  if (!converter) {
+    return false;
+  }
+
+  void* dxil_ptr = nullptr;
+  UINT32 dxil_size = 0;
+  wchar_t* diag = nullptr;
+
+  HRESULT hr = converter->Convert(
+      dxbc_data.data(), static_cast<UINT32>(dxbc_data.size()),
+      extra_options_.empty() ? nullptr : extra_options_.c_str(), &dxil_ptr,
+      &dxil_size, &diag);
+
+  if (hr != S_OK || dxil_ptr == nullptr || dxil_size == 0) {
+    if (error_message) {
+      if (diag) {
+        std::string diag_utf8;
+        for (const wchar_t* p = diag; *p; ++p) {
+          diag_utf8.push_back(static_cast<char>(*p));
+        }
+        *error_message = "dxbc2dxil failed: " + diag_utf8;
+      } else {
+        *error_message = "dxbc2dxil failed with HRESULT 0x" + HResultHex(hr);
+      }
+    }
+    CoTaskMemFree(diag);
+    CoTaskMemFree(dxil_ptr);
+    return false;
+  }
+
+  dxil_data_out.assign(reinterpret_cast<const uint8_t*>(dxil_ptr),
+                       reinterpret_cast<const uint8_t*>(dxil_ptr) + dxil_size);
+
+  CoTaskMemFree(diag);
+  CoTaskMemFree(dxil_ptr);
+
+  // Copy to debug directory if specified.
+  if (dxil_dir) {
+    std::string debug_output =
+        std::string(dxil_dir) + "/shader_" + shader_id + ".dxil";
+    WriteFile(debug_output, dxil_data_out);
+  }
+
+  // Validate DXIL header (DXBC magic for container, or DXIL for raw).
+  if (dxil_data_out.size() < 4) {
+    if (error_message) {
+      *error_message = "Output DXIL blob too small";
+    }
+    return false;
+  }
+
+  REXLOG_DEBUG(
+      "DxbcToDxilConverter: Successfully converted {} bytes DXBC to {} bytes "
+      "DXIL",
+      dxbc_data.size(), dxil_data_out.size());
+
+  return true;
+}
+
+IDxbcConverter* DxbcToDxilConverter::GetThreadConverter(
+    std::string* error_message) {
+  static thread_local ThreadConverter thread_state;
+  if (thread_state.converter) {
+    return thread_state.converter;
+  }
+
+  HRESULT hr =
+      DxcCreateInstance(kClsidDxbcConverter, __uuidof(IDxbcConverter),
+                        reinterpret_cast<void**>(&thread_state.converter));
+  if (hr != S_OK || !thread_state.converter) {
+    if (error_message) {
+      *error_message =
+          "Failed to create IDxbcConverter (HRESULT 0x" + HResultHex(hr) + ")";
+    }
+    return nullptr;
+  }
+  return thread_state.converter;
+}
+
+bool DxbcToDxilConverter::WriteFile(const std::string& path,
+                                    const std::vector<uint8_t>& data) {
+  std::ofstream file(path, std::ios::binary);
+  if (!file) {
+    return false;
+  }
+
+  file.write(reinterpret_cast<const char*>(data.data()), data.size());
+  return file.good();
+}
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/library_check.mm b/src/graphics/metal/library_check.mm
new file mode 100644
index 0000000..aee786c
--- /dev/null
+++ b/src/graphics/metal/library_check.mm
@@ -0,0 +1,44 @@
+// Verify generated libraries through the native Metal API without a window.
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <string>
+#include <vector>
+
+static id<MTLDevice> GetCheckDevice() {
+  static id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+  return device;
+}
+
+std::string MetalCheckDeviceName() {
+  @autoreleasepool {
+    id<MTLDevice> device = GetCheckDevice();
+    return device ? device.name.UTF8String : "";
+  }
+}
+
+bool CheckMetalLibrary(const std::vector<uint8_t>& bytes,
+                       const std::string& entry_point, std::string& error) {
+  @autoreleasepool {
+    id<MTLDevice> device = GetCheckDevice();
+    if (!device) {
+      error = "No Metal device available";
+      return false;
+    }
+    dispatch_data_t data = dispatch_data_create(bytes.data(), bytes.size(),
+        nullptr, ^{});
+    NSError* ns_error = nil;
+    id<MTLLibrary> library = [device newLibraryWithData:data error:&ns_error];
+    if (!library) {
+      error = ns_error ? ns_error.localizedDescription.UTF8String
+                       : "Metal failed to load library";
+      return false;
+    }
+    NSString* name = [NSString stringWithUTF8String:entry_point.c_str()];
+    id<MTLFunction> function = [library newFunctionWithName:name];
+    if (!function) {
+      error = "Metal entry point unavailable: " + entry_point;
+      return false;
+    }
+    return true;
+  }
+}
