+// Resource binding subset adapted from Alloy's Metal texture-cache interfaces.
+// Copyright 2026 Ben Vanik. BSD license; see SDK LICENSE.
+#include "texture_cache.h"
+#include <rex/graphics/pipeline/texture/util.h>
+#include <xxhash.h>
+#include <cstring>
+
+namespace rex::graphics::metal {
+NS::SharedPtr<MTL::Texture> MetalTextureCache::Request(
+    const xenos::xe_gpu_texture_fetch_t& fetch, xenos::FetchOpDimension dimension,
+    bool signed_view, MetalSharedMemory& memory, std::string& error) {
+  auto fail = [&](const char* text) { error = text; return NS::SharedPtr<MTL::Texture>{}; };
+  if (fetch.type != xenos::FetchConstantType::kTexture || dimension != xenos::FetchOpDimension::k2D ||
+      fetch.dimension != xenos::DataDimension::k2DOrStacked || fetch.stacked ||
+      fetch.format != xenos::TextureFormat::k_8_8_8_8 || fetch.mip_min_level || fetch.mip_max_level || fetch.packed_mips || fetch.border_size ||
+      fetch.lod_bias || fetch.grad_exp_adjust_h || fetch.grad_exp_adjust_v || uint32_t(fetch.arbitrary_filter) ||
+      fetch.sign_x != xenos::TextureSign::kUnsigned || fetch.sign_y != xenos::TextureSign::kUnsigned ||
+      fetch.sign_z != xenos::TextureSign::kUnsigned || fetch.sign_w != xenos::TextureSign::kUnsigned || fetch.num_format)
+    return fail("Only unsigned single-mip 2D RGBA8 textures are implemented");
+  const uint32_t width = fetch.size_2d.width + 1, height = fetch.size_2d.height + 1;
+  const uint32_t pitch = fetch.pitch << 5, base = fetch.base_address << 12;
+  if (!pitch || pitch < width || pitch > 4096 || width > 4096 || height > 4096 ||
+      (!fetch.tiled && ((pitch * 4) & 255))) return fail("Unsupported texture dimensions/pitch");
+  uint64_t extent = fetch.tiled ? texture_util::GetTiledAddressUpperBound2D(width, height, pitch, 2)
+                               : uint64_t(pitch) * 4 * height;
+  if (!extent || uint64_t(base) + extent > SharedMemory::kBufferSize ||
+      !memory.RequestRange(base, uint32_t(extent))) return fail("Texture source range is unavailable");
+  const auto* source = static_cast<const uint8_t*>(memory.GetBuffer()->contents()) + base;
+  std::array<uint64_t, 5> key{};
+  std::memcpy(key.data(), &fetch, sizeof(fetch)); key[3] = signed_view;
+  key[4] = XXH3_64bits(source, size_t(extent));
+  if (auto found = textures_.find(key); found != textures_.end()) return found->second;
+  std::vector<uint8_t> pixels(size_t(width) * height * 4);
+  for (uint32_t y = 0; y < height; ++y) for (uint32_t x = 0; x < width; ++x) {
+    const size_t offset = fetch.tiled ? uint32_t(texture_util::GetTiledOffset2D(x, y, pitch, 2))
+                                     : (size_t(y) * pitch + x) * 4;
+    if (offset + 4 > extent) return fail("Tiled texture address exceeds validated extent");
+    uint32_t packed; std::memcpy(&packed, source + offset, 4);
+    packed = xenos::GpuSwap(packed, fetch.endianness);
+    uint8_t components[4]; std::memcpy(components, &packed, 4);
+    for (uint32_t channel = 0; channel < 4; ++channel) {
+      uint32_t swizzle = (fetch.swizzle >> (channel * 3)) & 7;
+      if (swizzle > 5) return fail("Reserved texture swizzle");
+      pixels[(size_t(y) * width + x) * 4 + channel] = swizzle < 4 ? components[swizzle]
+          : (swizzle == 4 ? 0 : (signed_view ? 127 : 255));
+    }
+  }
+  auto descriptor = NS::TransferPtr(MTL::TextureDescriptor::alloc()->init());
+  descriptor->setTextureType(MTL::TextureType2DArray); descriptor->setArrayLength(1);
+  descriptor->setPixelFormat(signed_view ? MTL::PixelFormatRGBA8Snorm : MTL::PixelFormatRGBA8Unorm);
+  descriptor->setWidth(width); descriptor->setHeight(height);
+  descriptor->setUsage(MTL::TextureUsageShaderRead); descriptor->setStorageMode(MTL::StorageModeShared);
+  auto texture = NS::TransferPtr(device_->newTexture(descriptor.get()));
+  if (!texture) return fail("Metal texture allocation failed");
+  texture->replaceRegion(MTL::Region(0, 0, 0, width, height, 1), 0, 0, pixels.data(), width * 4, pixels.size());
+  if (textures_.size() >= 64 || cached_bytes_ + pixels.size() > 256 * 1024 * 1024) Clear();
+  cached_bytes_ += pixels.size();
+  textures_.emplace(key, texture);
+  return texture;
+}
+NS::SharedPtr<MTL::SamplerState> MetalTextureCache::Sampler(
+    const xenos::xe_gpu_texture_fetch_t& fetch, const DxbcShader::SamplerBinding& binding,
+    std::string& error) {
+  auto mag = binding.mag_filter == xenos::TextureFilter::kUseFetchConst ? fetch.mag_filter : binding.mag_filter;
+  auto min = binding.min_filter == xenos::TextureFilter::kUseFetchConst ? fetch.min_filter : binding.min_filter;
+  auto aniso = binding.aniso_filter == xenos::AnisoFilter::kUseFetchConst ? fetch.aniso_filter : binding.aniso_filter;
+  if (mag > xenos::TextureFilter::kLinear || min > xenos::TextureFilter::kLinear ||
+      aniso > xenos::AnisoFilter::kMax_1_1 || uint32_t(fetch.clamp_x) > 2 || uint32_t(fetch.clamp_y) > 2) {
+    error = "Unsupported sampler filtering/addressing"; return {};
+  }
+  auto descriptor = NS::TransferPtr(MTL::SamplerDescriptor::alloc()->init());
+  descriptor->setSupportArgumentBuffers(true); descriptor->setNormalizedCoordinates(true);
+  descriptor->setMagFilter(mag == xenos::TextureFilter::kLinear ? MTL::SamplerMinMagFilterLinear : MTL::SamplerMinMagFilterNearest);
+  descriptor->setMinFilter(min == xenos::TextureFilter::kLinear ? MTL::SamplerMinMagFilterLinear : MTL::SamplerMinMagFilterNearest);
+  descriptor->setMipFilter(MTL::SamplerMipFilterNotMipmapped);
+  const MTL::SamplerAddressMode modes[] = {MTL::SamplerAddressModeRepeat, MTL::SamplerAddressModeMirrorRepeat, MTL::SamplerAddressModeClampToEdge};
+  descriptor->setSAddressMode(modes[uint32_t(fetch.clamp_x)]); descriptor->setTAddressMode(modes[uint32_t(fetch.clamp_y)]);
+  auto sampler = NS::TransferPtr(device_->newSamplerState(descriptor.get()));
+  if (!sampler) error = "Metal sampler allocation failed";
+  return sampler;
+}
+}  // namespace rex::graphics::metal
