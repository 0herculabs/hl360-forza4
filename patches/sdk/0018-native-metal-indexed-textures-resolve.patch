+#pragma once
+#include <rex/graphics/metal/shared_memory.h>
+#include <rex/graphics/pipeline/shader/dxbc.h>
+#include <Foundation/NSSharedPtr.hpp>
+#include <array>
+#include <map>
+
+namespace rex::graphics::metal {
+// Initial CPU conversion path for single-mip unsigned RGBA8 guest textures.
+// Called after submitted GPU work has completed; guest data uses watched copies.
+class MetalTextureCache {
+ public:
+  explicit MetalTextureCache(MTL::Device* device) : device_(device) {}
+  NS::SharedPtr<MTL::Texture> Request(const xenos::xe_gpu_texture_fetch_t& fetch,
+      xenos::FetchOpDimension dimension, bool signed_view, MetalSharedMemory& memory,
+      std::string& error);
+  NS::SharedPtr<MTL::SamplerState> Sampler(const xenos::xe_gpu_texture_fetch_t& fetch,
+      const DxbcShader::SamplerBinding& binding, std::string& error);
+  void Clear() { textures_.clear(); cached_bytes_ = 0; }
+ private:
+  MTL::Device* device_;
+  size_t cached_bytes_ = 0;
+  std::map<std::array<uint64_t, 5>, NS::SharedPtr<MTL::Texture>> textures_;
+};
+}  // namespace rex::graphics::metal
