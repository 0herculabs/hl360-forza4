+// root must be a disposable copy: shader-storage shutdown persists its archive.
+extern "C" REX_GPU_PLUGIN_EXPORT int rex_gpu_metal_prewarm_validate(const char* root) {
+  try {
+    auto pool = NS::TransferPtr(NS::AutoreleasePool::alloc()->init());
+    REXCVAR_GET(metal_shader_disk_cache) = true;
+    REXCVAR_GET(metal_pipeline_disk_cache) = true;
+    REXCVAR_GET(metal_pipeline_binary_archive) = true;
+    rex::memory::Memory memory;
+    Require(memory.Initialize(), "Prewarm guest memory initialization failed");
+    DiagnosticGS graphics;
+    Require(graphics.Start(memory), "Prewarm backend initialization failed");
+    graphics.command_processor()->InitializeShaderStorage(root, 0x4D53084D, true);
+    graphics.Shutdown();
+    return 0;
+  } catch (const std::exception& error) {
+    std::fprintf(stderr, "Metal prewarm check failed: %s\n", error.what());
+    return 1;
+  }
+}
+
 extern "C" REX_GPU_PLUGIN_EXPORT int rex_gpu_metal_validate(const char* cache,const char* output) {
   try { Run(cache,output); return 0; }
   catch(const std::exception& e) { std::fprintf(stderr,"Full Metal backend check failed: %s\n",e.what()); return 2; }
