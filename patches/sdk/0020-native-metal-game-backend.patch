diff --git a/include/rex/ui/metal_runtime/metal_performance.h b/include/rex/ui/metal_runtime/metal_performance.h
new file mode 100644
--- /dev/null
+++ b/include/rex/ui/metal_runtime/metal_performance.h
@@ -0,0 +1,207 @@
+#ifndef XENIA_UI_METAL_METAL_PERFORMANCE_H_
+#define XENIA_UI_METAL_METAL_PERFORMANCE_H_
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::ui::metal_runtime {
+
+enum class PerfStage : size_t {
+  kDraw,
+  kTextureRequests,
+  kTextureCreate,
+  kTextureUpload,
+  kSwap,
+  kSubmit,
+  kGuestRefresh,
+  kPresent,
+  kDrawable,
+  kCount,
+};
+
+struct PerfStageSample {
+  uint64_t total_ns = 0;
+  uint64_t max_ns = 0;
+  uint64_t calls = 0;
+};
+
+// Shared by the emulation and UI threads. Snapshots are approximate reporting
+// windows: a concurrent sample may straddle a reset, but is never discarded.
+class PerfStageCounter {
+ public:
+  void Add(uint64_t ns) {
+    total_ns_.fetch_add(ns, std::memory_order_relaxed);
+    calls_.fetch_add(1, std::memory_order_relaxed);
+    auto previous = max_ns_.load(std::memory_order_relaxed);
+    while (previous < ns && !max_ns_.compare_exchange_weak(
+                                previous, ns, std::memory_order_relaxed)) {
+    }
+  }
+
+  PerfStageSample Take() {
+    return {total_ns_.exchange(0, std::memory_order_relaxed),
+            max_ns_.exchange(0, std::memory_order_relaxed),
+            calls_.exchange(0, std::memory_order_relaxed)};
+  }
+
+ private:
+  std::atomic<uint64_t> total_ns_{0};
+  std::atomic<uint64_t> max_ns_{0};
+  std::atomic<uint64_t> calls_{0};
+};
+
+inline std::array<PerfStageCounter, size_t(PerfStage::kCount)>&
+GetPerfStageCounters() {
+  static std::array<PerfStageCounter, size_t(PerfStage::kCount)> counters;
+  return counters;
+}
+
+// CPU-side elapsed time, including blocking calls. This does not measure GPU
+// execution time. Nested stages overlap and must not be added together.
+class ScopedPerfStage {
+ public:
+  ScopedPerfStage(PerfStage stage, bool enabled)
+      : stage_(stage), enabled_(enabled) {
+    if (enabled_) {
+      start_ = std::chrono::steady_clock::now();
+    }
+  }
+  ~ScopedPerfStage() {
+    if (enabled_) {
+      GetPerfStageCounters()[size_t(stage_)].Add(
+          std::chrono::duration_cast<std::chrono::nanoseconds>(
+              std::chrono::steady_clock::now() - start_)
+              .count());
+    }
+  }
+  ScopedPerfStage(const ScopedPerfStage&) = delete;
+  ScopedPerfStage& operator=(const ScopedPerfStage&) = delete;
+
+ private:
+  PerfStage stage_;
+  bool enabled_;
+  std::chrono::steady_clock::time_point start_;
+};
+
+struct WaitRegMemSample {
+  uint64_t elapsed_ns = 0;
+  uint64_t failed_polls = 0;
+  uint64_t sleeps = 0;
+  uint64_t requested_sleep_ns = 0;
+  uint64_t actual_sleep_ns = 0;
+  uint64_t max_sleep_overshoot_ns = 0;
+  uint32_t address = 0;
+  uint32_t raw_interval = 0;
+  bool is_memory = false;
+  bool matched = false;
+};
+
+// Only accessed on the Metal command processor thread, like its PerfStats.
+struct WaitRegMemCounters {
+  uint64_t calls = 0;
+  uint64_t blocked_calls = 0;
+  uint64_t memory_calls = 0;
+  uint64_t aborted_calls = 0;
+  uint64_t elapsed_ns = 0;
+  uint64_t failed_polls = 0;
+  uint64_t sleeps = 0;
+  uint64_t requested_sleep_ns = 0;
+  uint64_t actual_sleep_ns = 0;
+  uint64_t max_sleep_overshoot_ns = 0;
+  WaitRegMemSample longest;
+
+  void Add(const WaitRegMemSample& sample) {
+    ++calls;
+    blocked_calls += sample.failed_polls != 0;
+    memory_calls += sample.is_memory;
+    aborted_calls += !sample.matched;
+    elapsed_ns += sample.elapsed_ns;
+    failed_polls += sample.failed_polls;
+    sleeps += sample.sleeps;
+    requested_sleep_ns += sample.requested_sleep_ns;
+    actual_sleep_ns += sample.actual_sleep_ns;
+    max_sleep_overshoot_ns =
+        std::max(max_sleep_overshoot_ns, sample.max_sleep_overshoot_ns);
+    if (sample.elapsed_ns > longest.elapsed_ns) {
+      longest = sample;
+    }
+  }
+
+  WaitRegMemCounters Take() {
+    auto result = *this;
+    *this = {};
+    return result;
+  }
+};
+
+inline WaitRegMemCounters& GetWaitRegMemCounters() {
+  static WaitRegMemCounters counters;
+  return counters;
+}
+
+class ScopedWaitRegMem {
+ public:
+  ScopedWaitRegMem(bool is_memory, uint32_t address, uint32_t raw_interval,
+                   bool enabled)
+      : enabled_(enabled) {
+    if (enabled_) {
+      sample_.is_memory = is_memory;
+      sample_.address = address;
+      sample_.raw_interval = raw_interval;
+      start_ = std::chrono::steady_clock::now();
+    }
+  }
+  ~ScopedWaitRegMem() {
+    if (enabled_) {
+      sample_.elapsed_ns = ElapsedNs(start_);
+      GetWaitRegMemCounters().Add(sample_);
+    }
+  }
+  ScopedWaitRegMem(const ScopedWaitRegMem&) = delete;
+  ScopedWaitRegMem& operator=(const ScopedWaitRegMem&) = delete;
+
+  void Poll(bool matched) {
+    if (enabled_) {
+      sample_.matched = matched;
+      sample_.failed_polls += !matched;
+    }
+  }
+  void BeginSleep(uint32_t milliseconds) {
+    if (enabled_) {
+      sleep_requested_ns_ = uint64_t(milliseconds) * 1000000;
+      sample_.requested_sleep_ns += sleep_requested_ns_;
+      ++sample_.sleeps;
+      sleep_start_ = std::chrono::steady_clock::now();
+    }
+  }
+  void EndSleep() {
+    if (enabled_) {
+      uint64_t actual_ns = ElapsedNs(sleep_start_);
+      sample_.actual_sleep_ns += actual_ns;
+      uint64_t overshoot =
+          actual_ns > sleep_requested_ns_ ? actual_ns - sleep_requested_ns_ : 0;
+      sample_.max_sleep_overshoot_ns =
+          std::max(sample_.max_sleep_overshoot_ns, overshoot);
+    }
+  }
+
+ private:
+  static uint64_t ElapsedNs(std::chrono::steady_clock::time_point start) {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now() - start)
+        .count();
+  }
+  bool enabled_;
+  WaitRegMemSample sample_;
+  std::chrono::steady_clock::time_point start_;
+  std::chrono::steady_clock::time_point sleep_start_;
+  uint64_t sleep_requested_ns_ = 0;
+};
+
+}  // namespace rex::ui::metal
+
+#endif  // XENIA_UI_METAL_METAL_PERFORMANCE_H_
