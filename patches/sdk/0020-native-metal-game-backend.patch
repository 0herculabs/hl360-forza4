+push_const_end_xe
+
+entry_outputs_begin_xe
+  entry_out_xe(float2_xe, xe_out_texcoord, 0, TEXCOORD)
+  entry_out_xe(float4_xe, xe_out_color, 1, COLOR)
+  entry_out_position_xe
+entry_outputs_end_stage_inputs_begin_xe
