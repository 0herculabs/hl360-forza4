+      // r0.w = 12 > 20
+      a.OpLT(dxbc::Dest::R(0, 0b1000), dxbc::Src::R(0, dxbc::Src::kYYYY),
+             dxbc::Src::R(0, dxbc::Src::kXXXX));
+      // r0.x = 12 > 01
+      a.OpLT(dxbc::Dest::R(0, 0b0001), dxbc::Src::R(0, dxbc::Src::kZZZZ),
+             dxbc::Src::R(0, dxbc::Src::kXXXX));
