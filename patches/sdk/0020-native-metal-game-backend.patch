+        // 12 is the longest edge, the first triangle in the strip is 012.
+        a.OpMov(dxbc::Dest::R(0, 0b0111), dxbc::Src::LU(0, 1, 2, 0));
+      }
+      a.OpElse();
+      {
+        // r0.x = 20 > 01
+        a.OpLT(dxbc::Dest::R(0, 0b0001), dxbc::Src::R(0, dxbc::Src::kZZZZ),
+               dxbc::Src::R(0, dxbc::Src::kYYYY));
