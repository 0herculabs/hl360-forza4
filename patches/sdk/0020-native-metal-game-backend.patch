+  MTL::ComputePipelineState* load_pipelines_[kLoadShaderCount] = {};
+  MTL::ComputePipelineState* load_pipelines_scaled_[kLoadShaderCount] = {};
+
+  // Metal-specific Texture implementation
+
+  class MetalTexture : public Texture {
