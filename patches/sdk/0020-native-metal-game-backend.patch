+              dxbc::Src::V2D(0, input_register_position, dxbc::Src::kWWWW));
+      dxbc::Src point_radius_x_src(point_size_src.SelectFromSwizzled(0));
+      dxbc::Src point_radius_y_src(point_size_src.SelectFromSwizzled(1));
