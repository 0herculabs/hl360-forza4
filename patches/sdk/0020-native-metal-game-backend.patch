+extern "C" REX_GPU_PLUGIN_EXPORT int rex_gpu_metal_validate(const char* cache,const char* output) {
+  try { Run(cache,output); return 0; }
+  catch(const std::exception& e) { std::fprintf(stderr,"Full Metal backend check failed: %s\n",e.what()); return 2; }
+}
+
+namespace {
+class WindowTriangle final : public rex::ui::UIDrawer {
+ public:
+  WindowTriangle(rex::ui::ImmediateDrawer& drawer, rex::ui::Presenter& presenter,
+                 rex::ui::SDLWindowedAppContext& context)
+      : drawer_(drawer), presenter_(presenter), context_(context) {}
+  void Draw(rex::ui::UIDrawContext& context) override {
+    const rex::ui::ImmediateVertex vertices[] = {
+      {320,60,0,0,0xff4040ff}, {540,300,0,0,0xff40ff40}, {100,300,0,0,0xffff4040}};
+    drawer_.Begin(context,640,360);
+    rex::ui::ImmediateDrawBatch batch; batch.vertices=vertices; batch.vertex_count=3;
+    drawer_.BeginDrawBatch(batch); rex::ui::ImmediateDraw draw; draw.count=3;
+    drawer_.Draw(draw); drawer_.EndDrawBatch(); drawer_.End();
+    ++frames;
+    if(frames==30 || frames==60 || frames==90) {
+      const unsigned stage=frames/30;
+      context_.CallInUIThreadDeferred([this,stage] {
+        int count=0; SDL_Window** windows=SDL_GetWindows(&count);
+        if(!windows || count!=1 || !SDL_SetWindowSize(windows[0],stage==1?720:(stage==2?800:640),stage==1?405:(stage==2?450:360))) {
+          failed=true;
+        } else { ++resizes; }
+        SDL_free(windows);
+      });
+    }
+    if(frames>=120) context_.RequestDeferredQuit();
+    else presenter_.RequestUIPaintFromUIThread();
+  }
+  unsigned frames=0, resizes=0; bool failed=false;
+ private:
+  rex::ui::ImmediateDrawer& drawer_;
+  rex::ui::Presenter& presenter_;
+  rex::ui::SDLWindowedAppContext& context_;
+};
+void WindowRun() {
+  auto pool=NS::TransferPtr(NS::AutoreleasePool::alloc()->init());
+  rex::ui::SDLWindowedAppContext context;
+  Require(context.Initialize(),"SDL initialization failed");
+  auto provider=rex::ui::metal_runtime::MetalProvider::Create();
+  Require(bool(provider),"Window Metal provider failed");
+  auto window=rex::ui::Window::Create(context,"FM3 native Metal presentation check",640,360);
+  Require(window && window->Open(),"Native Metal window creation failed");
+  std::atomic<bool> gpu_lost=false, stopped=false, timeout=false;
+  auto presenter=provider->CreatePresenter([&](bool,bool){gpu_lost=true;context.RequestDeferredQuit();});
+  auto drawer=provider->CreateImmediateDrawer();
+  Require(presenter && drawer,"Native Metal window renderer setup failed");
+  drawer->SetPresenter(presenter.get()); window->SetPresenter(presenter.get());
+  WindowTriangle triangle(*drawer,*presenter,context);
+  presenter->AddUIDrawerFromUIThread(&triangle,0); presenter->RequestUIPaintFromUIThread();
+  std::thread deadline([&]{
+    auto limit=std::chrono::steady_clock::now()+std::chrono::seconds(15);
+    while(!stopped && std::chrono::steady_clock::now()<limit) std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    if(!stopped){timeout=true;context.RequestDeferredQuit();}
+  });
+  int result=context.RunMainMessageLoop(); stopped=true; deadline.join();
+  auto* drain=provider->GetCommandQueue()->commandBuffer(); drain->commit(); drain->waitUntilCompleted();
+  presenter->RemoveUIDrawerFromUIThread(&triangle); drawer->SetPresenter(nullptr); window->SetPresenter(nullptr);
+  Require(!result && !gpu_lost && !timeout && !triangle.failed && triangle.frames>=120 && triangle.resizes==3,
+      "Native Metal presentation/resize check failed");
+  Require(drain->status()==MTL::CommandBufferStatusCompleted,"Native Metal presentation queue failed");
+  std::printf("Native Metal SDL presentation passed: %u frames, %u resizes, clean shutdown\n",triangle.frames,triangle.resizes);
+}
+}
+extern "C" REX_GPU_PLUGIN_EXPORT int rex_gpu_metal_window_validate() {
+  try { WindowRun(); return 0; }
+  catch(const std::exception& e){std::fprintf(stderr,"Metal window check failed: %s\n",e.what());return 2;}
+}
diff --git a/src/ui/metal_runtime/embed_shader_sources.py b/src/ui/metal_runtime/embed_shader_sources.py
new file mode 100644
--- /dev/null
+++ b/src/ui/metal_runtime/embed_shader_sources.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Embed current XeSL/MSL sources for compilation by the installed Metal driver.
+
+Only project-local quoted includes are expanded. Metal's system headers and the
+language-specific conditional preprocessor blocks remain for the runtime compiler.
+Generated files are reproducible and are rewritten only when contents change.
+"""
+import argparse
+from pathlib import Path
+import re
+
+
+def expand(path, root, stack=()):
+    path = path.resolve()
+    if path in stack:
+        raise ValueError(f"Recursive shader include: {path}")
+    text = path.read_text()
+    def include(match):
+        child = (path.parent / match[1]).resolve()
+        if not child.is_relative_to(root):
+            raise ValueError(f"Shader include outside project: {child}")
+        return expand(child, root, (*stack, path))
+    return re.sub(r'^\s*#\s*include\s+"([^"]+)"[^\n]*$', include, text, flags=re.M)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--root', required=True, type=Path)
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    root = args.root.resolve()
+    used = set()
+    for sub in ('src/graphics/metal_runtime', 'src/ui/metal_runtime'):
+        for file in (root / sub).iterdir():
+            if file.suffix in ('.cpp', '.mm', '.h'):
+                used.update(re.findall(r'"(rex/(?:graphics|ui)/shaders/bytecode/metal/[^\"]+\.h)"', file.read_text()))
+    for include in sorted(used):
+        prefix, filename = include.split('/bytecode/metal/')
+        identifier = filename[:-2]
+        stem, stage = identifier.rsplit('_', 1)
+        source = root / 'src/metal_runtime_sources' / prefix.replace('rex/graphics', 'gpu').replace('rex/ui', 'ui') / f'{stem}.{stage}.metal'
+        if not source.exists():
+            source = source.with_suffix('.xesl')
+        if not source.exists():
+            raise FileNotFoundError(f"No current source for {include}: {source}")
+        msl = '#define SHADING_LANGUAGE_MSL_XE 1\n' + expand(source, root)
+        delimiter = 'XE_METAL_SOURCE'
+        if ')' + delimiter + '"' in msl:
+            raise ValueError(f"Raw string delimiter collision in {source}")
+        generated = ('// Generated from current shader sources; compiled by Metal at runtime.\n'
+                     '#pragma once\n#include <cstdint>\n'
+                     f'const uint8_t {identifier}_metallib[] = R"{delimiter}({msl}){delimiter}";\n')
+        output = args.output / include
+        output.parent.mkdir(parents=True, exist_ok=True)
+        if not output.exists() or output.read_text() != generated:
+            output.write_text(generated)
+
+
+if __name__ == '__main__':
+    main()
