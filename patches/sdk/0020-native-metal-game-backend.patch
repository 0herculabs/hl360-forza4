+    desc->colorAttachments()->object(0)->setPixelFormat(dest_format);
+  } else {
+    desc->colorAttachments()->object(0)->setPixelFormat(
+        MTL::PixelFormatInvalid);
+    desc->setDepthAttachmentPixelFormat(dest_format);
