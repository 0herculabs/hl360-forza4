+      float4_xe(
+          push_const_xe(xe_triangle_strip_rect_offset) +
+              float2_xe((uint_x2_xe(in_vertex_id_xe) >>
+                         uint2_xe(0u, 1u)) & 1u) *
+              push_const_xe(xe_triangle_strip_rect_size),
+          0.0f, 1.0f);
+}
+entry_code_end_xe
