+inline int64_t PerfNowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+void PerfOnSwap() {
+  auto now = std::chrono::steady_clock::now();
+  auto& p = g_perf;
+  if (p.last_swap.time_since_epoch().count()) {
+    int64_t frame_ns =
+        std::chrono::duration_cast<std::chrono::nanoseconds>(now - p.last_swap)
+            .count();
+    p.max_frame_ns = std::max(p.max_frame_ns, frame_ns);
+    if (frame_ns > 40000000) {
+      ++p.frames_over_40ms;
+    }
+  }
+  p.last_swap = now;
+  ++p.swaps;
+  if (!p.window_start.time_since_epoch().count()) {
+    p.window_start = now;
+    return;
+  }
+  auto window = now - p.window_start;
+  if (window < std::chrono::seconds(1)) {
+    return;
+  }
+  if (REXCVAR_GET(metal_perf_log)) {
+    double secs =
+        std::chrono::duration_cast<std::chrono::duration<double>>(window)
+            .count();
+    REXLOG_INFO(
+        "Perf: fps={:.1f} frame_max={:.1f}ms slow_frames(>40ms)={} "
+        "draws/frame={} gpu_wait={:.1f}ms/s ({} waits) "
+        "pipelines_slow={} ({:.1f}ms, max {:.1f}ms) shaders={} ({:.1f}ms) "
+        "geom_skipped={} depth_only/frame={} (tess {}) "
+        "async_pipelines={} async_skipped_draws={} async_shaders={} "
+        "archive_hits={} archive_misses={} (no_fragment {}) prewarm_hits={} "
+        "sync_points(int/r2m/mw/cw/ews/other)={}/{}/{}/{}/{}/{} "
+        "sync_waits={}/{}/{}/{}/{}/{}",
+        p.swaps / secs, p.max_frame_ns / 1e6, p.frames_over_40ms,
+        p.swaps ? p.draws / p.swaps : 0, p.wait_ns / 1e6 / secs, p.waits,
+        p.pipelines_slow, p.pipelines_ns / 1e6, p.pipelines_max_ns / 1e6,
+        p.shaders, p.shaders_ns / 1e6, p.geometry_skipped,
+        p.swaps ? (p.depth_only_tess + p.depth_only_plain) / p.swaps : 0,
+        p.swaps ? p.depth_only_tess / p.swaps : 0, p.async_pipelines,
+        p.async_skipped_draws, p.async_shaders, p.archive_hits,
+        p.archive_misses, p.archive_misses_no_fragment, p.prewarm_hits,
+        p.sync_points[0], p.sync_points[1], p.sync_points[2],
+        p.sync_points[3], p.sync_points[4], p.sync_points[5],
+        p.sync_waits[0], p.sync_waits[1], p.sync_waits[2], p.sync_waits[3],
+        p.sync_waits[4], p.sync_waits[5]);
+    constexpr const char* stage_names[] = {
+        "draw", "texture_requests", "texture_create", "texture_upload",
+        "swap", "submit", "guest_refresh", "present", "drawable_wait"};
+    auto& counters = ui::metal_runtime::GetPerfStageCounters();
+    std::string stages;
+    for (size_t i = 0; i < counters.size(); ++i) {
+      auto sample = counters[i].Take();
+      stages += fmt::format(" {}={:.2f}ms/frame (max_call={:.2f}ms, calls={})",
+                            stage_names[i],
+                            p.swaps ? sample.total_ns / 1e6 / p.swaps : 0.0,
+                            sample.max_ns / 1e6, sample.calls);
+    }
+    REXLOG_INFO("PerfStages: window={:.3f}s guest_frames={}{}", secs, p.swaps,
+           stages);
+    auto waits = ui::metal_runtime::GetWaitRegMemCounters().Take();
+    REXLOG_INFO(
+        "PerfWaitRegMem: window={:.3f}s calls={} blocked={} mem={} reg={} "
+        "aborted={} elapsed={:.2f}ms/frame max_wait={:.2f}ms failed_polls={} "
+        "sleeps={} requested_sleep={:.2f}ms actual_sleep={:.2f}ms "
+        "max_oversleep={:.2f}ms longest_kind={} longest_addr={:08X} "
+        "longest_interval={:X} longest_failed_polls={} longest_sleeps={}",
+        secs, waits.calls, waits.blocked_calls, waits.memory_calls,
+        waits.calls - waits.memory_calls, waits.aborted_calls,
+        p.swaps ? waits.elapsed_ns / 1e6 / p.swaps : 0.0,
+        waits.longest.elapsed_ns / 1e6, waits.failed_polls, waits.sleeps,
+        waits.requested_sleep_ns / 1e6, waits.actual_sleep_ns / 1e6,
+        waits.max_sleep_overshoot_ns / 1e6,
+        waits.calls ? (waits.longest.is_memory ? "mem" : "reg") : "none",
+        waits.longest.address, waits.longest.raw_interval,
+        waits.longest.failed_polls, waits.longest.sleeps);
+  }
+  auto last_swap = p.last_swap;
+  p = PerfStats();
+  p.window_start = now;
+  p.last_swap = last_swap;
+}
+
+void PerfAddPipelineTime(int64_t ns) {
+  if (ns > 500000) {
+    ++g_perf.pipelines_slow;
+    g_perf.pipelines_ns += ns;
+    g_perf.pipelines_max_ns = std::max(g_perf.pipelines_max_ns, ns);
+  }
+}
+
+void MaybeLogRenderStats() {
+  auto now = std::chrono::steady_clock::now();
+  auto& s = g_render_stats;
+  if (!REXCVAR_GET(metal_perf_log) || now - s.last_log < std::chrono::seconds(2)) {
+    return;
+  }
+  s.last_log = now;
+  REXLOG_INFO(
+      "MetalStats: draws={} skipped={} copies={} copies_written={} "
+      "(last {:08X}+{:X}) swaps={} swaps_no_tex={} fb={:08X} swap={}x{} "
+      "fmt={} tex={}x{} pf={}",
+      s.draws, s.draws_skipped, s.copies, s.copies_written, s.last_copy_addr,
+      s.last_copy_len, s.swaps, s.swaps_no_texture, s.frontbuffer,
+      s.last_swap_w, s.last_swap_h, s.last_swap_fmt, s.last_tex_w,
+      s.last_tex_h, s.last_tex_pf);
+}
