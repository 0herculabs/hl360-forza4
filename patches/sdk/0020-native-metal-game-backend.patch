+++ b/src/graphics/metal_runtime/CMakeLists.txt
@@ -0,0 +1,35 @@
+# Full Alloy native Metal renderer adapted to ReXGlue.
+if(NOT APPLE OR NOT REXGLUE_BUILD_METAL_SHADER_TOOLS)
+    message(FATAL_ERROR "Metal requires macOS and staged Metal conversion dependencies")
+endif()
+set(_generated "${CMAKE_CURRENT_BINARY_DIR}/generated")
+find_package(Python3 REQUIRED COMPONENTS Interpreter)
+execute_process(COMMAND ${Python3_EXECUTABLE} "${REXGLUE_ROOT}/src/ui/metal_runtime/embed_shader_sources.py"
+    --root "${REXGLUE_ROOT}" --output "${_generated}" COMMAND_ERROR_IS_FATAL ANY)
+set(_cross "${REXGLUE_METAL_DEPS_ROOT}/spirv-cross")
+add_library(rexmetal-spirv-cross STATIC
+    "${_cross}/spirv_cross.cpp" "${_cross}/spirv_parser.cpp"
+    "${_cross}/spirv_cross_parsed_ir.cpp" "${_cross}/spirv_cfg.cpp"
