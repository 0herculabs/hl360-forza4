+          XeDXTOpaqueRowToRGB8(bgr_end_8in10, bgr_weights >> 8u) +
+              ((block.xxxx >> uint4_xe(16u, 20u, 24u, 28u)) & 0xFu) *
+              0x11000000u);
+      dont_flatten_xe if (texel_index_host.y + 2u < load_info.height_texels) {
