+  dxbc::Statistics stat;
+  std::memset(&stat, 0, sizeof(dxbc::Statistics));
+  dxbc::Assembler a(shader_out, stat);
+
+  a.OpDclGlobalFlags(dxbc::kGlobalFlagAllResourcesBound);
+
+  if (system_cbuffer_size_vector_aligned_bytes) {
