+
+#include "rex/graphics/metal_runtime/metal_primitive_processor.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <memory>
+#include <utility>
+
+#include "rex/assert.h"
+#include "rex/logging.h"
+#include "rex/graphics/flags.h"
+#include "rex/graphics/metal_runtime/metal_command_processor.h"
+
