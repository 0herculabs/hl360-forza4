+                               pixel_index + int2_xe(1, 0),
+                               source_sample_left).r,
+          texel_fetch_2d_ms_xe(xe_host_depth_store_source,
+                               pixel_index + int2_xe(1, 0),
+                               source_sample_right).r)));
