+ private:
+  // GPU-based texture loading entry point. Returns true on success.
+  bool TryGpuLoadTexture(Texture& texture, bool load_base, bool load_mips);
+  MTL::StorageMode GetCacheTextureStorageMode() const;
+  bool ShouldUploadViaBlit() const;
+  void BeginUploadCommandBufferBatch();
+  void EndUploadCommandBufferBatch();
+  void AbortUploadCommandBufferBatch(bool commit_if_has_work = true);
+
+ public:
+  // Records a guest memory range written by the GPU (resolve) in the given,
+  // not yet committed, command buffer. Texture loads from such ranges must be
+  // encoded in the same command buffer after the write - a separate command
+  // buffer committed earlier would execute before the write and load stale
+  // data.
+  void NoteGpuWrittenRange(MTL::CommandBuffer* command_buffer, uint32_t start,
