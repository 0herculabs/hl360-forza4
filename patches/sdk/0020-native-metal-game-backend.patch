--- /dev/null
+++ b/src/graphics/metal_runtime/runtime_check.cpp
@@ -0,0 +1,315 @@
+// Full game-backend check. Controlled guest data; does not launch FM3.
+#include <rex/graphics/metal_runtime/metal_graphics_system.h>
+#include <rex/graphics/metal_runtime/metal_command_processor.h>
+#include <rex/graphics/metal_runtime/flags.h>
+#include <rex/system/gpu_plugin.h>
+#include <rex/ui/metal_runtime/metal_presenter.h>
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/graphics/pipeline/texture/util.h>
+#include <rex/ui/metal_runtime/metal_provider.h>
+#include <rex/ui/window.h>
+#include <rex/ui/windowed_app_context_sdl.h>
+#include <SDL3/SDL.h>
+#include <atomic>
+#include <chrono>
+#include <thread>
+#include <Foundation/NSSharedPtr.hpp>
+#include <xxhash.h>
+#include <bit>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <stdexcept>
+#include <vector>
+extern "C" rex::system::IGraphicsSystem* rex_gpu_create(uint32_t, const rex::system::GpuCreateInfo*);
+namespace {
+using namespace rex::graphics;
+using rex::X_STATUS;
+void Require(bool ok, const char* message) { if (!ok) throw std::runtime_error(message); }
+struct CachedShader { uint32_t type; std::vector<uint32_t> code; };
+std::map<uint64_t, CachedShader> Load(const char* filename) {
+  std::ifstream input(filename, std::ios::binary);
+  auto read = [&](auto* data, size_t n) { return bool(input.read(reinterpret_cast<char*>(data), sizeof(*data) * n)); };
+  uint32_t header[2];
+  Require(read(header, 2) && header[0] == 0x48534558 && std::byteswap(header[1]) == 0x20201219, "Invalid shader cache");
+  std::map<uint64_t, CachedShader> shaders;
+  while (input.peek() != std::char_traits<char>::eof()) {
+    uint64_t hash = 0; uint32_t info = 0;
+    Require(read(&hash, 1) && read(&info, 1), "Truncated shader record");
+    CachedShader shader{info >> 31, {}};
+    uint32_t count = info & 0x7fffffff;
+    Require(count && count <= 0xffff, "Invalid shader length");
+    shader.code.resize(count);
+    Require(read(shader.code.data(), count), "Truncated shader data");
+    Require(XXH3_64bits(shader.code.data(), count * 4) == hash, "Shader hash mismatch");
+    shaders.emplace(hash, std::move(shader));
+  }
+  return shaders;
+}
+
+class DiagnosticCP : public metal_runtime::MetalCommandProcessor {
+ public:
+  explicit DiagnosticCP(metal_runtime::MetalGraphicsSystem* gs) : MetalCommandProcessor(gs, nullptr) {}
+  bool Start() { started_ = SetupContext(); return started_; }
+  void Shutdown() override { if (started_) { ShutdownContext(); started_ = false; } }
+  void Flush() { PrepareForWait(); }
+ private:
+  bool started_ = false;
+};
+class DiagnosticGS : public metal_runtime::MetalGraphicsSystem {
+ public:
+  bool Start(rex::memory::Memory& memory) {
+    memory_ = &memory;
+    if (SetupPresentation(nullptr) != X_STATUS_SUCCESS) return false;
+    command_processor_ = std::make_unique<DiagnosticCP>(this);
+    return static_cast<DiagnosticCP*>(command_processor_.get())->Start();
+  }
+};
+void Run(const char* cache, const char* output) {
+  auto pool = NS::TransferPtr(NS::AutoreleasePool::alloc()->init());
+  rex::system::GpuCreateInfo info{sizeof(info), "metal"};
+  {
+    std::unique_ptr<rex::system::IGraphicsSystem> factory(rex_gpu_create(rex::system::kGpuPluginAbiVersion, &info));
+    Require(dynamic_cast<metal_runtime::MetalGraphicsSystem*>(factory.get()) != nullptr, "Metal plugin factory failed");
+    Require(factory->SetupPresentation(nullptr) == X_STATUS_SUCCESS, "Factory presenter initialization failed");
+    auto drawer = factory->provider()->CreateImmediateDrawer();
+    Require(bool(drawer), "Metal UI drawer initialization failed");
+    factory->Shutdown();
+  }
+  auto shaders = Load(cache);
+  constexpr uint64_t vs = 0x1E6883FCCDE1F688, ps = 0xA4A965C189287B99;
+  constexpr uint64_t tvs = 0x7156CE05C6365E51, tps = 0x6E57A6E305D5D69B;
