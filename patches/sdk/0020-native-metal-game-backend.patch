+static_assert(sizeof(PipelineDiskCacheHeader) == 16,
+              "Unexpected pipeline disk cache header size.");
+static_assert(sizeof(PipelineDiskCacheEntryHeader) == 8,
+              "Unexpected pipeline disk cache entry header size.");
