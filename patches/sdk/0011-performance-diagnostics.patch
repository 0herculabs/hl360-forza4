diff --git a/include/rex/graphics/performance.h b/include/rex/graphics/performance.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/performance.h
@@ -0,0 +1,59 @@
+// Optional CPU elapsed-time diagnostics. These are inclusive wall times,
+// not GPU timestamps. Nested stages and different threads must not be summed.
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <cstdint>
+#include <rex/logging.h>
+
+namespace rex::graphics::performance {
+enum class Stage { Draw, Resolve, FenceWait, Submission, QueueSubmit, Swap,
+                   PipelineCompile, WaitRegMem, Acquire, Present, PresenterWait, Count };
+inline constexpr const char* kNames[] = {"draw", "resolve", "fence_wait", "submission",
+    "queue_submit", "swap", "pipeline_compile", "wait_reg_mem", "acquire", "present", "presenter_wait"};
+inline bool Enabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("FM3_PERF_LOG");
+    return value && value[0] == '1';
+  }();
+  return enabled;
+}
+using Clock = std::chrono::steady_clock;
+struct Counter { uint64_t calls = 0; double total = 0, maximum = 0; };
+struct Window {
+  Clock::time_point start = Clock::now();
+  std::array<Counter, size_t(Stage::Count)> counters{};
+};
+inline Window& GetWindow() { static thread_local Window window; return window; }
+class Scope {
+ public:
+  explicit Scope(Stage stage) : stage_(stage), enabled_(Enabled()) {
+    if (enabled_) start_ = Clock::now();
+  }
+  ~Scope() {
+    if (!enabled_) return;
+    auto now = Clock::now();
+    double ms = std::chrono::duration<double, std::milli>(now - start_).count();
+    auto& window = GetWindow();
+    auto& counter = window.counters[size_t(stage_)];
+    ++counter.calls;
+    counter.total += ms;
+    if (ms > counter.maximum) counter.maximum = ms;
+    double seconds = std::chrono::duration<double>(now - window.start).count();
+    if (seconds < 1.0) return;
+    for (size_t i = 0; i < window.counters.size(); ++i) {
+      auto& c = window.counters[i];
+      if (c.calls) REXLOG_INFO("perf_cpu: window_s={:.6f} stage={} calls={} total_ms={:.3f} max_ms={:.3f}",
+                              seconds, kNames[i], c.calls, c.total, c.maximum);
+      c = {};
+    }
+    window.start = now;
+  }
+ private:
+  Stage stage_;
+  bool enabled_;
+  Clock::time_point start_{};
+};
+}  // namespace rex::graphics::performance
