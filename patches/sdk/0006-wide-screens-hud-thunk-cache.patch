+// hud_squeeze_vertex_shaders, parsed when it changes.
+bool SqueezesVertexShader(uint64_t hash) {
+  static std::string parsed_from;
+  static std::vector<uint64_t> hashes;
+  const std::string& value = REXCVAR_GET(hud_squeeze_vertex_shaders);
+  if (value.empty()) return false;
+  if (value != parsed_from) {
+    parsed_from = value;
+    hashes.clear();
+    size_t start = 0;
+    while (start < value.size()) {
+      size_t end = value.find(',', start);
+      if (end == std::string::npos) end = value.size();
+      const std::string item = value.substr(start, end - start);
+      if (!item.empty()) hashes.push_back(std::strtoull(item.c_str(), nullptr, 16));
+      start = end + 1;
+    }
+  }
+  return std::find(hashes.begin(), hashes.end(), hash) != hashes.end();
+}
+
+// hud_squeeze: maps every pixel x of a draw to center + (x - center) / squeeze,
+// moving the draw's viewport and scissor; the viewport stays whole pixels, the
+// remainder goes into the NDC transform.
+// Places the draw's viewport at [left, left + width) in pixels, on a host
+// viewport of whole pixels from host_left, host_width wide.
+void PlaceViewportX(float left, float width, float host_left, float host_width,
+                    rex::graphics::draw_util::ViewportInfo& viewport) {
+  viewport.ndc_offset[0] =
+      (viewport.ndc_offset[0] + 1.0f) * width / host_width + 2.0f * (left - host_left) / host_width -
+      1.0f;
+  viewport.ndc_scale[0] = viewport.ndc_scale[0] * width / host_width;
+  viewport.xy_offset[0] = uint32_t(host_left);
+  viewport.xy_extent[0] = uint32_t(host_width);
+}
+
+void SqueezeX(float center, float squeeze, rex::graphics::draw_util::ViewportInfo& viewport,
+              rex::graphics::draw_util::Scissor& scissor) {
+  const float left = center + (float(viewport.xy_offset[0]) - center) / squeeze;
+  const float width = float(viewport.xy_extent[0]) / squeeze;
+  const float host_left = std::max(0.0f, std::floor(left));
+  const float host_width = std::max(1.0f, std::ceil(left + width) - host_left);
+  PlaceViewportX(left, width, host_left, host_width, viewport);
+  const float scissor_left = center + (float(scissor.offset[0]) - center) / squeeze;
+  const float scissor_right =
+      center + (float(scissor.offset[0] + scissor.extent[0]) - center) / squeeze;
+  scissor.offset[0] = uint32_t(std::max(0.0f, std::floor(scissor_left)));
+  scissor.extent[0] = uint32_t(std::max(0.0f, std::ceil(scissor_right) - float(scissor.offset[0])));
+}
+
+// Where hud_squeeze puts a draw.
+enum class HudPlacement {
+  kNone,
+  // Narrowed about the image's centre, or kept at its left or right edge.
+  kCenter,
+  kLeft,
+  kRight,
+  // hud_squeeze_edges for many elements in one draw: each triangle is placed
+  // by the geometry shader.
+  kEdgesShader,
+};
+
+HudPlacement GetHudPlacement(const rex::graphics::RegisterFile& regs, uint64_t vertex_shader_hash,
+                             uint32_t normalized_color_mask,
+                             const rex::graphics::PrimitiveProcessor::ProcessingResult& primitive) {
+  using namespace rex::graphics;
+  if (REXCVAR_GET(hud_squeeze) <= 1.0 || !normalized_color_mask) return HudPlacement::kNone;
+  // Screen-space overlays the title draws into the scene (FM4's virtual
+  // mirror) are named by their vertex shader and stay centred.
+  if (SqueezesVertexShader(vertex_shader_hash)) return HudPlacement::kCenter;
+  if (regs.Get<reg::RB_COLOR_INFO>(XE_GPU_REG_RB_COLOR_INFO).color_format !=
+      xenos::ColorRenderTargetFormat::k_2_10_10_10_AS_10_10_10_10) {
+    return HudPlacement::kNone;
+  }
+  if (!REXCVAR_GET(hud_squeeze_edges)) return HudPlacement::kCenter;
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  if (!vte.vport_x_scale_ena || !vte.vport_x_offset_ena) return HudPlacement::kCenter;
+  // In guest pixels: the image, the viewport, the scissor.
+  const float image = float(regs.Get<reg::RB_SURFACE_INFO>().surface_pitch);
+  const float scale = std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE));
+  const float offset = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET);
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  const float left = std::max(offset - scale, float(scissor.offset[0]));
+  const float right = std::min(offset + scale, float(scissor.offset[0] + scissor.extent[0]));
+  const bool whole = offset - scale <= 1.0f && offset + scale >= image - 1.0f &&
+                     scissor.offset[0] == 0 && float(scissor.extent[0]) >= image;
+  if (whole) {
+    // A layer over the whole image: per triangle, when they are triangles.
+    const bool triangles = primitive.host_vertex_shader_type == Shader::HostVertexShaderType::kVertex &&
+                           (primitive.host_primitive_type == xenos::PrimitiveType::kTriangleList ||
+                            primitive.host_primitive_type == xenos::PrimitiveType::kTriangleStrip);
+    return triangles ? HudPlacement::kEdgesShader : HudPlacement::kCenter;
+  }
+  // A draw of its own (FM4's minimap): placed by its viewport and scissor.
+  const float threshold = float(std::clamp(REXCVAR_GET(hud_squeeze_edges_threshold), 0.0, 1.0));
+  if (right <= image * 0.5f * (1.0f - threshold)) return HudPlacement::kLeft;
+  if (left >= image * 0.5f * (1.0f + threshold)) return HudPlacement::kRight;
+  return HudPlacement::kCenter;
+}
