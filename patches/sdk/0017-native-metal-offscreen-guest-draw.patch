+// Native Metal provider/setup adaptation for ReXGlue's split GPU setup API.
+#include <rex/graphics/metal/graphics_system.h>
+#include <rex/graphics/metal/command_processor.h>
+#include <rex/ui/metal/provider.h>
+
+namespace rex::graphics::metal {
+MetalGraphicsSystem::~MetalGraphicsSystem() { Shutdown(); }
+void MetalGraphicsSystem::CreateProvider(bool with_presentation) {
+  provider_ = ui::metal::MetalProvider::Create(with_presentation);
+}
+std::unique_ptr<CommandProcessor> MetalGraphicsSystem::CreateCommandProcessor() {
+  return std::make_unique<MetalCommandProcessor>(this, kernel_state_);
+}
+bool MetalGraphicsSystem::InitializeOffscreen(memory::Memory& memory, uint32_t width, uint32_t height) {
+  if (command_processor_ || !memory.physical_membase()) return false;
+  memory_ = &memory;
+  CreateProvider(false);
+  if (!provider_) return false;
+  command_processor_ = CreateCommandProcessor();
+  if (!static_cast<MetalCommandProcessor*>(command_processor_.get())->InitializeOffscreen(width, height)) {
+    Shutdown();
+    return false;
+  }
+  return true;
+}
+void MetalGraphicsSystem::Shutdown() { GraphicsSystem::Shutdown(); }
+}  // namespace rex::graphics::metal
