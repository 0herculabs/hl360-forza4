+#pragma once
+#include <rex/graphics/command_processor.h>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace rex::graphics::metal {
+// Experimental offscreen subset of Alloy's native Metal command processor.
+// Uses the SDK's PM4 decoder. Not registered as a selectable game backend.
+class MetalCommandProcessor final : public CommandProcessor {
+ public:
+  MetalCommandProcessor(GraphicsSystem* graphics, system::KernelState* kernel);
+  ~MetalCommandProcessor() override;
+  // Synchronous, owner-thread path without a guest CPU/kernel worker.
+  bool InitializeOffscreen(uint32_t width, uint32_t height);
+  void Shutdown() override;
+  bool ReadbackRGBA(std::vector<uint8_t>& rgba);
+  uint64_t draw_count() const;
+  const std::string& last_error() const;
+  void InvalidateGpuMemory() override;
+  void IssueSwap(uint32_t, uint32_t, uint32_t) override;
+
+ protected:
+  bool SetupContext() override;
+  void ShutdownContext() override;
+  void PrepareForWait() override;
+  Shader* LoadShader(xenos::ShaderType, uint32_t, const uint32_t*, uint32_t) override;
+  bool IssueDraw(xenos::PrimitiveType, uint32_t, IndexBufferInfo*, bool) override;
+  bool IssueCopy() override;
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+  bool offscreen_ = false;
+  bool Fail(std::string error);
+};
+}  // namespace rex::graphics::metal
