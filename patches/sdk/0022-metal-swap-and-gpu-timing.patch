+
+// GPU completion callbacks update this independently of CPU timing windows.
+// Sum of command-buffer execution intervals, not frame latency or total GPU load.
+class GpuTimingCounter {
+ public:
+  void Add(uint64_t ns) {
+    total_ns_.fetch_add(ns, std::memory_order_relaxed);
+    calls_.fetch_add(1, std::memory_order_relaxed);
+    auto old = max_ns_.load(std::memory_order_relaxed);
+    while (old < ns && !max_ns_.compare_exchange_weak(old, ns, std::memory_order_relaxed)) {}
+  }
+  PerfStageSample Take() {
+    return {total_ns_.exchange(0), max_ns_.exchange(0), calls_.exchange(0)};
+  }
+ private:
+  std::atomic<uint64_t> total_ns_{0}, max_ns_{0}, calls_{0};
+};
+
+inline GpuTimingCounter& GetGpuCommandTimings() {
+  static GpuTimingCounter counter;
+  return counter;
+}
 
