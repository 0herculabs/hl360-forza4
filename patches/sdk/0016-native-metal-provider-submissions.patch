diff --git a/include/rex/ui/metal/submission_tracker.h b/include/rex/ui/metal/submission_tracker.h
new file mode 100644
index 0000000..0351ca9
--- /dev/null
+++ b/include/rex/ui/metal/submission_tracker.h
@@ -0,0 +1,50 @@
+#pragma once
+/**
+ * Adapted from Xenia-Alloy's metal_gpu_completion_timeline.h/cc.
+ * Copyright 2026 Ben Vanik. All rights reserved.
+ * Released under the BSD license; see LICENSE in the SDK root.
+ */
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <string>
+#include <rex/ui/metal/api.h>
+
+namespace rex::ui::metal {
+// Single owner thread, one queue per tracker, like ReXGlue's Vulkan tracker.
+// Submit owns commit, so a dropped/uncommitted buffer never advances the index.
+// Completed means retired (safe to release resources); await returns false if
+// any submission through the requested index failed, so readback must stop.
+class MetalSubmissionTracker {
+ public:
+  static std::unique_ptr<MetalSubmissionTracker> Create(
+      MTL::CommandQueue* queue, bool use_shared_event = true);
+  ~MetalSubmissionTracker();
+  MetalSubmissionTracker(const MetalSubmissionTracker&) = delete;
+  MetalSubmissionTracker& operator=(const MetalSubmissionTracker&) = delete;
+
+  uint64_t GetCurrentSubmission() const { return upcoming_; }
+  uint64_t UpdateAndGetCompletedSubmission();
+  bool AwaitSubmissionCompletion(uint64_t submission);
+  bool AwaitAllSubmissionsCompletion() { return AwaitSubmissionCompletion(upcoming_ - 1); }
+  // Buffer must be from this queue, not enqueued/committed, with all encoders ended.
+  // Returns 0 for rejected buffers (no index consumed). Retains submitted buffers.
+  uint64_t Submit(MTL::CommandBuffer* buffer);
+  bool has_failed_submission() const { return first_failed_ != 0; }
+  const std::string& last_error() const { return last_error_; }
+  // For future encoder dependencies. Host waits use command-buffer status too:
+  // on GPU error a shared event may never signal.
+  MTL::SharedEvent* shared_event() const { return event_; }
+
+ private:
+  explicit MetalSubmissionTracker(MTL::CommandQueue* queue);
+  struct Pending { uint64_t index; MTL::CommandBuffer* buffer; };
+  MTL::CommandQueue* queue_;
+  MTL::SharedEvent* event_ = nullptr;
+  uint64_t upcoming_ = 1;
+  uint64_t completed_ = 0;
+  uint64_t first_failed_ = 0;
+  std::string last_error_;
+  std::deque<Pending> pending_;
+};
+}  // namespace rex::ui::metal
