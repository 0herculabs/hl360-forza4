+void WindowSDL::RestoreDesktopBeforeHardExit() {
+  if (!sdl_window_) return;
+  // Explicitly leave fullscreen while SDL can still restore the display and
+  // notify the compositor. _Exit skips SDL's normal window/video teardown.
+  if (SDL_GetWindowFlags(sdl_window_) & SDL_WINDOW_FULLSCREEN) {
+    if (!SDL_SetWindowFullscreen(sdl_window_, false)) {
+      REXLOG_WARN("Fullscreen restoration on exit failed: {}", SDL_GetError());
+    } else if (!SDL_SyncWindow(sdl_window_)) {
+      REXLOG_WARN("Fullscreen restoration sync failed: {}", SDL_GetError());
+    }
+  }
+  SDL_HideWindow(sdl_window_);
+  DestroySDLWindow();
+  REXLOG_INFO("Desktop presentation restored; SDL window destroyed before hard exit");
+}
